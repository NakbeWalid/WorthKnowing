{
  "name": "miroir-et-boreal",
  "version": "0.1.0",
  "private": true,
  "description": "Miroir (profil comportemental d'investisseur) + Boréal Courtage (plateforme de courtage fictive qui l'utilise) — simulation uniquement",
  "scripts": {
    "build": "nest build",
    "start": "node scripts/start-all.mjs",
    "start:miroir": "node dist/miroir/main.js",
    "start:bank": "node dist/bank/main.js",
    "start:dev:miroir": "nest start --watch --entryFile miroir/main",
    "start:dev:bank": "nest start --watch --entryFile bank/main",
    "scenarios": "python3 scripts/build_scenarios.py",
    "test:unit": "node scripts/test-influence.mjs && node scripts/test-profile.mjs && node scripts/test-simulations.mjs",
    "test": "node scripts/test_all_features.mjs",
    "test:e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-bedrock-runtime": "^3.1169.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1169.0",
    "@aws-sdk/client-dynamodb": "^3.1169.0",
    "@aws-sdk/client-s3": "^3.1169.0",
    "@aws-sdk/lib-dynamodb": "^3.1169.0",
    "@nestjs/common": "^10.4.0",
    "@nestjs/core": "^10.4.0",
    "@nestjs/platform-express": "^10.4.0",
    "@nestjs/serve-static": "^4.0.2",
    "aws-jwt-verify": "^5.2.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.0",
    "@types/express": "^4.17.21",
    "@types/node": "^22.0.0",
    "typescript": "^5.5.0"
  }
}
