PORT=3000
JWT_SECRET=change-me
ADMIN_EMAIL=admin@miroir.local
ADMIN_PASSWORD=admin123
DRIFT_THRESHOLD=60

# --- AWS (voir README, section « Variables d'environnement ») ---
AWS_REGION=us-east-1
STORAGE_DRIVER=json        # json | dynamodb
AUTH_DRIVER=local          # local | cognito
NEWS_DRIVER=mock           # mock | bedrock
INFLUENCE_DRIVER=off       # off | bedrock
EXPLAINER_DRIVER=template  # template | bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Sorties de la pile MiroirData (infra/outputs.json)
DATA_BUCKET=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
