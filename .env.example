# ===== Miroir (service de profil) — http://localhost:3000 =====
PORT=3000
JWT_SECRET=change-me
LINK_SECRET=change-me-too          # signe les codes de liaison et les codes persona
ADMIN_EMAIL=admin@miroir.local
ADMIN_PASSWORD=admin123
DRIFT_THRESHOLD=60
PARTNER_NAME=Boréal Courtage
PARTNER_RETURN_ORIGINS=http://localhost:3001

# ===== Boréal Courtage (plateforme fictive) — http://localhost:3001 =====
BANK_PORT=3001
BANK_JWT_SECRET=change-me
BANK_PUBLIC_URL=http://localhost:3001
MIROIR_PUBLIC_URL=http://localhost:3000
MIROIR_API_URL=http://localhost:3000

# ===== Secret partagé entre les deux applications =====
PARTNER_API_KEY=dev-partner-key-change-me

# ===== AWS (voir README, section « Variables d'environnement ») =====
AWS_REGION=us-east-1
STORAGE_DRIVER=json        # json | dynamodb   (Miroir)
BANK_STORAGE_DRIVER=json   # json | dynamodb   (Boréal)
AUTH_DRIVER=local          # local | cognito   (Miroir)
NEWS_DRIVER=mock           # mock | bedrock
INFLUENCE_DRIVER=off       # off | bedrock
EXPLAINER_DRIVER=template  # template | bedrock
BEDROCK_MODEL_ID=us.anthropic.claude-haiku-4-5-20251001-v1:0
# Sorties de la pile MiroirData (infra/outputs.json)
DATA_BUCKET=
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
